{
  "name": "correspondencia",
  "version": "0.1.0",
  "private": true,
  "description": "Registro y consulta privada de correspondencia por lote",
  "packageManager": "pnpm@10.34.8",
  "engines": {
    "node": ">=22.11.0"
  },
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "build": "pnpm -r --if-present build",
    "dev:api": "pnpm --filter @correspondencia/api dev",
    "dev:web": "pnpm --filter @correspondencia/web start",
    "dev:worker": "pnpm --filter @correspondencia/worker dev"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0"
  }
}
