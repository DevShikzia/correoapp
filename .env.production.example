# Copiar a `.env.production` en la raíz del repositorio, completar los secretos y
# darle permisos 600. No versionar este archivo con valores reales.

NODE_ENV=production
LOG_LEVEL=info

# Origen exacto con el que se abre la web en el navegador.
# En la primera prueba por LAN: http://IP_DE_LA_NOTEBOOK:8080
# Con Cloudflare/HTTPS: https://dominio-real
APP_ORIGIN=http://192.168.0.67:8080

# Cookies Secure: false solo mientras se prueba por HTTP en la red local.
# Al pasar a HTTPS, cambiar a true (o borrar la variable).
COOKIE_SECURE=false
TRUST_PROXY=1

# Puerto del host para la web. No usar 80: ya lo ocupa la app de facturación.
WEB_PORT=8080

# MongoDB interno de Compose (no se publica).
MONGO_ROOT_USER=correspondencia_root
MONGO_ROOT_PASSWORD=cambiar-por-password-aleatorio
MONGO_DATABASE=correspondencia
MONGO_APP_USER=correspondencia_app
MONGO_APP_PASSWORD=cambiar-por-password-aleatorio

# Sesiones
SESSION_SECRET=cambiar-por-64-caracteres-hexadecimales
STAFF_SESSION_TTL_MINUTES=480
PUBLIC_SESSION_TTL_MINUTES=30

# Redis interno de Compose (no se publica).
REDIS_URL=redis://redis:6379

# Notificaciones: se dejan apagadas en el primer despliegue.
NOTIFICATIONS_ENABLED=false
WHATSAPP_PROVIDER=disabled
NOTIFICATION_MAX_ATTEMPTS=5
NOTIFICATION_BACKOFF_MS=30000
NOTIFICATION_CONCURRENCY=5

# Solo para WHATSAPP_PROVIDER=meta
WHATSAPP_API_URL=https://graph.facebook.com/v23.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=es_AR
