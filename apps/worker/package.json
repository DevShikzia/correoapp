    "test": "vitest run --passWithNoTests"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "pino": "10.4.0",
    "zod": "4.6.7"
  }
}
