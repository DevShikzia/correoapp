# Copiar a .env y completar con valores reales. Nunca versionar .env.

# Entorno: development | test | production
NODE_ENV=development

# API
PORT=3000
LOG_LEVEL=info

# MongoDB (solo red interna de Docker; no publicar el puerto)
# Dentro de Compose el host es `mongo`; fuera de Docker usar 127.0.0.1.
MONGO_ROOT_USER=correspondencia_admin
MONGO_ROOT_PASSWORD=cambiar-por-password-local
MONGO_DATABASE=correspondencia
MONGODB_URI=mongodb://correspondencia_admin:cambiar-por-password-local@mongo:27017/correspondencia?authSource=admin
# Puerto local del MongoDB de Compose en desarrollo. Cambiar si 27017 ya está ocupado.
MONGO_HOST_PORT=27017

# Redis para la cola de notificaciones (Fase 6)
# Dentro de Compose el host es `redis`; fuera de Docker usar 127.0.0.1.
REDIS_URL=redis://redis:6379
# Puerto local del Redis de Compose en desarrollo. Cambiar si 6379 ya está ocupado.
REDIS_HOST_PORT=6379

# Secreto de firma de sesiones: generar uno aleatorio por entorno.
# Obligatorio cuando NODE_ENV=production.
SESSION_SECRET=reemplazar-por-secreto-aleatorio-de-al-menos-32-bytes

# Origen permitido para peticiones que modifican datos (protección CSRF).
# Obligatorio en producción; en desarrollo, definirlo evita aceptar otros orígenes.
APP_ORIGIN=http://localhost:4200

# Duración de la sesión de vigiladores, en minutos (5 a 10080)
STAFF_SESSION_TTL_MINUTES=480

# Duración de la sesión temporal de propietario, en minutos
PUBLIC_SESSION_TTL_MINUTES=30

# Bootstrap del primer administrador (usar una sola vez y luego borrar del .env)
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=cambiar-por-password-de-al-menos-12-caracteres

# Notificaciones por WhatsApp (Fase 6)
# Apagadas por defecto: con NOTIFICATIONS_ENABLED=false no se crean avisos, no se
# usa Redis y la API solo guarda la correspondencia.
NOTIFICATIONS_ENABLED=false
# Proveedor: disabled | console | meta
# - console: no envía mensajes reales; solo registra el intento en el log.
# - meta: WhatsApp Cloud API (requiere plantilla aprobada y credenciales).
WHATSAPP_PROVIDER=disabled
# Reintentos máximos por aviso y espera base del backoff exponencial (ms).
NOTIFICATION_MAX_ATTEMPTS=5
NOTIFICATION_BACKOFF_MS=30000
# Cantidad de avisos procesados en paralelo por el worker.
NOTIFICATION_CONCURRENCY=5

# Credenciales de Meta: completar solo con WHATSAPP_PROVIDER=meta.
WHATSAPP_API_URL=https://graph.facebook.com/v23.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=
# Secreto de la app de Meta: valida la firma X-Hub-Signature-256 del webhook.
WHATSAPP_APP_SECRET=
# Token del GET de verificación del webhook (mínimo 8 caracteres).
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Plantilla aprobada con dos variables en el cuerpo: {{1}} lote, {{2}} descripción.
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=es_AR
