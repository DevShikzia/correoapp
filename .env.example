# Copiar a .env y completar con valores reales. Nunca versionar .env.

# Entorno: development | test | production
NODE_ENV=development

# API
PORT=3000
LOG_LEVEL=info

# MongoDB (solo red interna de Docker; no publicar el puerto)
# Dentro de Compose el host es `mongo`; fuera de Docker usar 127.0.0.1.
MONGO_ROOT_USER=correspondencia_admin
MONGO_ROOT_PASSWORD=cambiar-por-password-local
MONGO_DATABASE=correspondencia
MONGODB_URI=mongodb://correspondencia_admin:cambiar-por-password-local@mongo:27017/correspondencia?authSource=admin

# Redis para la cola de notificaciones (Fase 6)
REDIS_URL=redis://redis:6379

# Secreto de firma de sesiones: generar uno aleatorio por entorno.
# Obligatorio cuando NODE_ENV=production.
SESSION_SECRET=reemplazar-por-secreto-aleatorio-de-al-menos-32-bytes

# Duración de la sesión temporal de propietario, en minutos
PUBLIC_SESSION_TTL_MINUTES=30

# WhatsApp (se configura recién en la Fase 6)
# WHATSAPP_API_URL=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_TOKEN=
# WHATSAPP_WEBHOOK_SECRET=
